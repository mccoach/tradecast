# ============================================================
# TradeCast - Python Project .gitignore
# ============================================================
# 说明：
# - 本项目为 Python 项目，当前目录中包含 .venv、.vscode、若干 .py 文件和配置文件。
# - 强烈建议不要提交 .venv 虚拟环境目录。
# - 如果 TradeCast_config.json 含有账号、Token、路径、交易参数等私人配置，建议忽略。
# ============================================================


# ============================================================
# 1. Python 虚拟环境
# ============================================================

.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# 如果曾经把虚拟环境放在其他名称下，也一并忽略
.virtualenv/
pythonenv/


# ============================================================
# 2. Python 缓存 / 编译文件
# ============================================================

__pycache__/
*.py[cod]
*$py.class

# C 扩展 / 二进制扩展
*.so
*.pyd
*.dll
*.dylib

# Python 解释器相关
.python-version


# ============================================================
# 3. 打包 / 构建 / 发布产物
# ============================================================

build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/

*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Nuitka / Cython / 编译缓存
*.c
*.cpp
*.h
*.html
*.pyd
*.lib
*.exp


# ============================================================
# 4. 安装包 / 依赖锁相关缓存
# ============================================================

pip-wheel-metadata/
pip-log.txt
pip-delete-this-directory.txt

# Poetry / PDM / Hatch 等工具缓存
.poetry/
.pdm-python
.pdm-build/
.hatch/
.hatch_build/


# ============================================================
# 5. 测试 / 覆盖率 / 静态检查缓存
# ============================================================

.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# 类型检查
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Ruff / Black / isort 等
.ruff_cache/
.black/
.isort.cfg


# ============================================================
# 6. Jupyter / Notebook
# ============================================================

.ipynb_checkpoints/


# ============================================================
# 7. IDE / 编辑器配置
# ============================================================

# VS Code:
# 当前项目中已有 .vscode/launch.json 和 .vscode/settings.json。
# 如果这些配置只适用于你本机，建议忽略整个 .vscode/。
# 如果希望团队共享调试配置，可参考下方“保留部分配置”的写法。

.vscode/

# 如果你想提交部分 VS Code 配置，可改成：
# .vscode/*
# !.vscode/settings.json
# !.vscode/launch.json
# !.vscode/extensions.json

# PyCharm / JetBrains
.idea/
*.iml

# Sublime
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*.swp
*.swo
*~
.#*
\#*\#


# ============================================================
# 8. 操作系统文件
# ============================================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Linux
*~


# ============================================================
# 9. 日志文件
# ============================================================

logs/
log/
*.log
*.log.*
debug.log
error.log
runtime.log


# ============================================================
# 10. 临时文件 / 备份文件
# ============================================================

tmp/
temp/
.tmp/
.temp/
99_归档/

*.tmp
*.temp
*.bak
*.backup
*.old
*.orig
*.rej
*.save

# Office 临时文件
~$*
*.~lock.*


# ============================================================
# 11. 数据文件 / 导出文件
# ============================================================
# 说明：
# 如果你的程序会生成行情数据、交易记录、回测结果、Excel/CSV 报表等，
# 通常不建议提交到 Git，尤其是文件可能较大或包含隐私信息。

data/
dataset/
datasets/
exports/
export/
output/
outputs/
reports/
report/
results/
result/
backtest/
backtests/

*.csv
*.tsv
*.xlsx
*.xls
*.xlsm
*.ods
*.jsonl
*.parquet
*.feather
*.pkl
*.pickle
*.h5
*.hdf5
*.sqlite
*.sqlite3
*.db

# 如果你确实需要提交示例数据，建议建立 examples/ 或 sample_data/ 并使用例外规则：
# !examples/
# !examples/**
# !sample_data/
# !sample_data/**


# ============================================================
# 12. 配置文件 / 密钥 / 环境变量
# ============================================================

.env
.env.*
*.env

secrets/
secret/
credentials/
credential/

*.key
*.pem
*.crt
*.cer
*.pfx
*.p12

# 本项目中的配置文件
# 如果 TradeCast_config.json 包含 API Key、账号、路径、交易策略参数等个人信息，建议忽略。
TradeCast_config.json

# 建议提交一个示例配置文件，例如：
# TradeCast_config.example.json
!TradeCast_config.example.json


# ============================================================
# 13. 交易 / 金融项目常见本地文件
# ============================================================

# 交易记录、订单、持仓、账户快照等
orders/
positions/
accounts/
account/
trades/
trade_logs/
snapshots/
cache_market/
market_cache/

*.trade
*.orders
*.positions

# 回测、优化、策略结果
optimization/
optimizations/
signals/
signal_cache/


# ============================================================
# 14. 程序运行缓存
# ============================================================

cache/
.cache/
runtime/
run/
runs/
state/
states/

*.cache
*.pid
*.lock


# ============================================================
# 15. 本地脚本输出 / 用户自定义文件
# ============================================================

local/
.local/
private/
_private/

*_local.py
*_local.json
*_private.py
*_private.json


# ============================================================
# 16. 压缩包 / 归档文件
# ============================================================

*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.gz
*.bz2
*.xz


# ============================================================
# 17. 可执行文件 / Windows 产物
# ============================================================

*.exe
*.msi
*.bat
*.cmd
*.ps1

# 注意：
# 如果你有项目必须提交的脚本，例如 scripts/*.bat，可以添加例外：
# !scripts/*.bat


# ============================================================
# 18. Git / 工具生成文件
# ============================================================

*.patch
*.diff


# ============================================================
# 19. 保留重要源码文件
# ============================================================
# 当前项目根目录有：
# - TradeCast.py
# - TradeCast v2.py
# - TradeCast v3.py
#
# 这些 .py 文件默认不会被忽略。
# 如果文件名包含空格没有问题，但长期建议改名为：
# - tradecast.py
# - tradecast_v2.py
# - tradecast_v3.py
#
# 不需要额外规则。


# ============================================================
# 20. 可选：忽略所有本地 JSON 配置，但保留示例配置
# ============================================================
# 如需更严格地防止误提交配置，可取消下面两行注释：
# *.json
# !*.example.json
